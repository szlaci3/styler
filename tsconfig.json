{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "server/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
